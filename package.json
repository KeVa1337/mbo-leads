{
  "name": "mbo-leads",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram-бот, що ловить замовлення для фрилансерів у публічних каналах і миттєво надсилає підписникам",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "fast-xml-parser": "^5.12.0",
    "grammy": "^1.46.0",
    "node-html-parser": "^9.0.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
