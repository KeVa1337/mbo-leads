# Секрети (токен бота, ключ Claude, пароль бази) задаються в змінних середовища Coolify, не в цьому файлі.
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
DATABASE_URL=postgres://user:password@host:5432/leads
ADMIN_TELEGRAM_ID=

# Необов'язкові.
# Модель для розбору постів; claude-haiku-5-5 приблизно в 40 разів дешевша
LEADS_MODEL=claude-opus-5-5
LEADS_EFFORT=low
FETCH_INTERVAL_SEC=180
FREE_DAILY_LIMIT=5
# Публічні канали через кому: @канал1,@канал2
INITIAL_CHANNELS=
TIMEZONE=Europe/Kyiv
MONTHLY_BUDGET_USD=30
# Контакт підтримки, напр. @your_username
SUPPORT_CONTACT=
# Threads: довгостроковий токен (threads_basic, threads_keyword_search); порожньо — Threads вимкнений
THREADS_ACCESS_TOKEN=
THREADS_INTERVAL_MIN=15
