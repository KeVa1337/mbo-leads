# Секрети (токен бота, ключ Claude, пароль бази) задаються в змінних середовища Coolify, не в цьому файлі.
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
DATABASE_URL=postgres://user:password@host:5432/leads
ADMIN_TELEGRAM_ID=

# Необов'язкові
LEADS_MODEL=claude-opus-5-5        # claude-haiku-5-5 приблизно в 40 разів дешевша
LEADS_EFFORT=low
FETCH_INTERVAL_SEC=180
FREE_DAILY_LIMIT=5
INITIAL_CHANNELS=                   # @канал1,@канал2
TIMEZONE=Europe/Kyiv
MONTHLY_BUDGET_USD=30
SUPPORT_CONTACT=                    # напр. @your_username
